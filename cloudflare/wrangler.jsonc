{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prk-math-solver",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-18",
  "account_id": "13dd0fcfce652a9f94a69bf3cec8e989",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "ai": { "binding": "AI" },
  "vars": { "MODEL": "@cf/google/gemma-4-26b-a4b-it" },
  "ratelimits": [
    {
      "name": "REQUEST_LIMITER",
      "namespace_id": "24011",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "TOTAL_LIMITER",
      "namespace_id": "24012",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "observability": { "enabled": false },
}
